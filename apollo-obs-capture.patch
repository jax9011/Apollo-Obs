diff -ruN apollo/Apollo-master/src/platform/windows/display_obs.cpp apollo_new/src/platform/windows/display_obs.cpp
--- apollo/Apollo-master/src/platform/windows/display_obs.cpp	1970-01-01 00:00:00.000000000 +0000
+++ apollo_new/src/platform/windows/display_obs.cpp	2026-11-13 01:36:01.463402040 +0000
@@ -0,0 +1,386 @@
+/**
+ * @file src/platform/windows/display_obs.cpp
+ * @brief "obs" capture backend: frames come from the obs-moonlight OBS plugin
+ *        through shared memory instead of capturing the desktop.
+ *
+ * Enable with:  capture = obs   and   encoder = software   (sunshine.conf)
+ * Windows layout (up to 10) is available from obs_layout_json().
+ */
+// standard includes
+#include <algorithm>
+#include <chrono>
+#include <cstring>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <thread>
+
+// platform includes
+#include <windows.h>
+#include <shlobj.h>
+#include <wtsapi32.h>
+
+// lib includes
+#include <nlohmann/json.hpp>
+
+// local includes
+#include "moonlight_shm.h"
+#include <boost/process/v1/environment.hpp>
+#include <boost/filesystem.hpp>
+
+#include "src/logging.h"
+#include "src/platform/common.h"
+#include "src/video.h"
+
+namespace platf {
+  using namespace std::literals;
+
+  namespace {
+    std::mutex shm_mutex;
+    HANDLE shm_map = nullptr;
+    uint8_t *shm_base = nullptr;
+
+    /**
+     * @brief Create (or open) the shared mapping. Apollo is the creator so the
+     *        OBS plugin, running as a normal user, only needs to open it.
+     */
+    MoonlightShm *shm_open_or_create() {
+      std::lock_guard lg {shm_mutex};
+      if (shm_base) {
+        return reinterpret_cast<MoonlightShm *>(shm_base);
+      }
+
+      // NULL DACL: every local process (OBS in the user session) may open it.
+      SECURITY_DESCRIPTOR sd;
+      InitializeSecurityDescriptor(&sd, SECURITY_DESCRIPTOR_REVISION);
+      SetSecurityDescriptorDacl(&sd, TRUE, nullptr, FALSE);
+      SECURITY_ATTRIBUTES sa {sizeof(sa), &sd, FALSE};
+
+      const ULONGLONG size = MOONLIGHT_SHM_BYTES;
+      shm_map = CreateFileMappingW(INVALID_HANDLE_VALUE, &sa, PAGE_READWRITE, (DWORD) (size >> 32), (DWORD) (size & 0xFFFFFFFF), MOONLIGHT_SHM_NAME);
+      if (!shm_map) {
+        BOOST_LOG(error) << "[obs] CreateFileMapping failed: "sv << GetLastError();
+        return nullptr;
+      }
+      shm_base = static_cast<uint8_t *>(MapViewOfFile(shm_map, FILE_MAP_ALL_ACCESS, 0, 0, MOONLIGHT_SHM_BYTES));
+      if (!shm_base) {
+        BOOST_LOG(error) << "[obs] MapViewOfFile failed: "sv << GetLastError();
+        CloseHandle(shm_map);
+        shm_map = nullptr;
+        return nullptr;
+      }
+      auto *h = reinterpret_cast<MoonlightShm *>(shm_base);
+      if (h->magic != MOONLIGHT_SHM_MAGIC) {
+        std::memset(h, 0, sizeof(*h));
+        h->magic = MOONLIGHT_SHM_MAGIC;
+        h->version = MOONLIGHT_SHM_VERSION;
+      }
+      return h;
+    }
+
+    struct obs_img_t: img_t {
+      ~obs_img_t() override {
+        delete[] data;
+        data = nullptr;
+      }
+    };
+  }  // namespace
+
+  class display_obs_ram_t: public display_t {
+  public:
+    int init(const ::video::config_t &config, const std::string &) {
+      hdr = shm_open_or_create();
+      if (!hdr) {
+        return -1;
+      }
+      framerate = config.framerate > 0 ? config.framerate : 60;
+
+      // If OBS is already streaming, adopt its canvas size. Otherwise start
+      // with the requested size (black frames) and reinit when OBS connects.
+      if (hdr->writer_alive && hdr->width && hdr->height) {
+        width = (int) hdr->width;
+        height = (int) hdr->height;
+      } else {
+        width = config.width > 0 ? config.width : 1920;
+        height = config.height > 0 ? config.height : 1080;
+        BOOST_LOG(info) << "[obs] OBS plugin not streaming yet, showing black until it connects"sv;
+      }
+      width &= ~1;  // keep even for 4:2:0
+      height &= ~1;
+      env_width = width;
+      env_height = height;
+      return 0;
+    }
+
+    capture_e capture(const push_captured_image_cb_t &push_captured_image_cb, const pull_free_image_cb_t &pull_free_image_cb, bool *) override {
+      const auto interval = std::chrono::nanoseconds(1'000'000'000LL / framerate);
+      uint64_t last_seq = 0;
+      auto deadline = std::chrono::steady_clock::now();
+
+      while (true) {
+        std::shared_ptr<img_t> img;
+        if (!pull_free_image_cb(img)) {
+          return capture_e::interrupted;
+        }
+
+        // wait for a new frame or the frame deadline
+        bool fresh = false;
+        deadline += interval;
+        while (true) {
+          const bool alive = hdr->writer_alive != 0;
+          if (alive && hdr->width && hdr->height && (((int) hdr->width & ~1) != width || ((int) hdr->height & ~1) != height)) {
+            return capture_e::reinit;  // OBS canvas size changed
+          }
+          if (alive && hdr->frame_seq != last_seq) {
+            fresh = true;
+            break;
+          }
+          if (std::chrono::steady_clock::now() >= deadline) {
+            break;
+          }
+          std::this_thread::sleep_for(1ms);
+        }
+        if (deadline < std::chrono::steady_clock::now() - 100ms) {
+          deadline = std::chrono::steady_clock::now();  // we fell behind, resync
+        }
+
+        if (fresh) {
+          const uint32_t front = hdr->front & 1;
+          last_seq = hdr->frame_seq;
+          const uint8_t *src = shm_base + MOONLIGHT_HDR_BYTES + (size_t) front * MOONLIGHT_FRAME_BYTES;
+          const int src_stride = (int) hdr->width * 4;
+          for (int y = 0; y < height; ++y) {
+            std::memcpy(img->data + (size_t) y * img->row_pitch, src + (size_t) y * src_stride, (size_t) width * 4);
+          }
+          img->frame_timestamp = std::chrono::steady_clock::now();
+        }
+
+        if (!push_captured_image_cb(std::move(img), fresh)) {
+          return capture_e::ok;
+        }
+      }
+    }
+
+    std::shared_ptr<img_t> alloc_img() override {
+      auto img = std::make_shared<obs_img_t>();
+      img->width = width;
+      img->height = height;
+      img->pixel_pitch = 4;
+      img->row_pitch = width * 4;
+      return img;
+    }
+
+    int dummy_img(img_t *img) override {
+      img->pixel_pitch = 4;
+      img->row_pitch = img->width * 4;
+      if (!img->data) {
+        img->data = new std::uint8_t[(size_t) img->row_pitch * img->height];
+      }
+      std::fill_n(img->data, (size_t) img->row_pitch * img->height, 0);
+      return 0;
+    }
+
+    std::unique_ptr<avcodec_encode_device_t> make_avcodec_encode_device(pix_fmt_e) override {
+      return std::make_unique<avcodec_encode_device_t>();
+    }
+
+  private:
+    MoonlightShm *hdr {};
+    int framerate {60};
+  };
+
+  /** @brief Factory used by display() in display_base.cpp when capture == "obs". */
+  std::shared_ptr<display_t> obs_display(const ::video::config_t &config, const std::string &display_name) {
+    auto disp = std::make_shared<display_obs_ram_t>();
+    if (disp->init(config, display_name)) {
+      return nullptr;
+    }
+    return disp;
+  }
+
+  /** @brief JSON describing the canvas and every streamed window (for the client / VR app). */
+  std::string obs_layout_json() {
+    nlohmann::json out;
+    auto *h = shm_open_or_create();
+    out["active"] = h && h->writer_alive;
+    out["windows"] = nlohmann::json::array();
+    if (!h) {
+      return out.dump();
+    }
+    out["canvas"] = {{"width", h->width}, {"height", h->height}};
+    out["layout_seq"] = h->layout_seq;
+    const uint32_t n = std::min<uint32_t>(h->window_count, MOONLIGHT_MAX_WINDOWS);
+    for (uint32_t i = 0; i < n; ++i) {
+      const auto &w = h->windows[i];
+      out["windows"].push_back({
+        {"index", i},
+        {"x", w.x},
+        {"y", w.y},
+        {"width", w.w},
+        {"height", w.h},
+        {"z", w.z},
+        {"visible", w.visible != 0},
+        {"name", std::string(w.name, strnlen(w.name, sizeof(w.name)))},
+        {"window", std::string(w.window, strnlen(w.window, sizeof(w.window)))},
+      });
+    }
+    return out.dump();
+  }
+}  // namespace platf
+
+
+// ---- VR client support: /vrapps, /vrlaunch, /vrwindows ------------------------------------
+namespace platf {
+  namespace {
+    struct pc_app_t {
+      std::string name;
+      std::string path;  // .lnk file
+    };
+    std::mutex apps_mutex;
+    std::vector<pc_app_t> apps_cache;
+
+    std::string narrow(const std::wstring &w) {
+      if (w.empty()) return {};
+      int n = WideCharToMultiByte(CP_UTF8, 0, w.data(), (int) w.size(), nullptr, 0, nullptr, nullptr);
+      std::string s(n, '\0');
+      WideCharToMultiByte(CP_UTF8, 0, w.data(), (int) w.size(), s.data(), n, nullptr, nullptr);
+      return s;
+    }
+
+    std::string lower(std::string s) {
+      for (auto &c : s) c = (char) tolower((unsigned char) c);
+      return s;
+    }
+
+    void scan_dir(const std::filesystem::path &dir, std::vector<pc_app_t> &out) {
+      std::error_code ec;
+      if (!std::filesystem::exists(dir, ec)) return;
+      auto it = std::filesystem::recursive_directory_iterator(dir, std::filesystem::directory_options::skip_permission_denied, ec);
+      for (; !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+        if (it.depth() > 3 || !it->is_regular_file(ec)) continue;
+        if (lower(it->path().extension().string()) != ".lnk") continue;
+        std::string name = narrow(it->path().stem().wstring());
+        const std::string l = lower(name);
+        if (l.find("uninstall") != std::string::npos || l.find("readme") != std::string::npos || l.find("license") != std::string::npos) continue;
+        out.push_back({name, narrow(it->path().wstring())});
+      }
+    }
+
+    void add_known_folder(REFKNOWNFOLDERID id, HANDLE token, std::vector<pc_app_t> &out) {
+      PWSTR p = nullptr;
+      if (SUCCEEDED(SHGetKnownFolderPath(id, 0, token, &p)) && p) {
+        scan_dir(p, out);
+        CoTaskMemFree(p);
+      }
+    }
+
+    std::vector<pc_app_t> scan_apps() {
+      std::vector<pc_app_t> out;
+      HANDLE token = nullptr;
+      // Apollo runs as a service: use the logged-in user's Start menu as well
+      DWORD session = WTSGetActiveConsoleSessionId();
+      if (session != 0xFFFFFFFF && !WTSQueryUserToken(session, &token)) token = nullptr;
+      add_known_folder(FOLDERID_CommonPrograms, nullptr, out);
+      add_known_folder(FOLDERID_PublicDesktop, nullptr, out);
+      if (token) {
+        add_known_folder(FOLDERID_Programs, token, out);
+        add_known_folder(FOLDERID_Desktop, token, out);
+        CloseHandle(token);
+      }
+      std::sort(out.begin(), out.end(), [](const pc_app_t &a, const pc_app_t &b) {
+        return lower(a.name) < lower(b.name);
+      });
+      out.erase(std::unique(out.begin(), out.end(), [](const pc_app_t &a, const pc_app_t &b) {
+                  return lower(a.name) == lower(b.name);
+                }),
+                out.end());
+      return out;
+    }
+  }  // namespace
+
+  /** @brief JSON array [{id,name}] of apps found in the Start menu / desktop of the PC. */
+  std::string vr_apps_json() {
+    std::lock_guard lg {apps_mutex};
+    apps_cache = scan_apps();
+    nlohmann::json arr = nlohmann::json::array();
+    for (size_t i = 0; i < apps_cache.size(); ++i) {
+      arr.push_back({{"id", (int) i + 1}, {"name", apps_cache[i].name}});
+    }
+    return arr.dump();
+  }
+
+  /**
+   * @brief Start one app of the last /vrapps list in the user's session and tell the OBS plugin to
+   *        adopt its new window(s).
+   */
+  bool vr_launch(int id, const std::string &name) {
+    std::string path;
+    {
+      std::lock_guard lg {apps_mutex};
+      if (id < 1 || (size_t) id > apps_cache.size() || apps_cache[id - 1].name != name) {
+        BOOST_LOG(warning) << "[obs] /vrlaunch: list changed or unknown app: "sv << name;
+        return false;
+      }
+      path = apps_cache[id - 1].path;
+    }
+
+    // tell the OBS plugin first so it already has the "before" window list
+    if (auto *h = shm_open_or_create()) {
+      std::memset((void *) h->launch_name, 0, sizeof(h->launch_name));
+      std::strncpy((char *) h->launch_name, name.c_str(), sizeof(h->launch_name) - 1);
+      MemoryBarrier();
+      h->launch_seq++;
+    }
+
+    auto working_dir = boost::filesystem::path();
+    boost::process::v1::environment env = boost::this_process::environment();
+    std::error_code ec;
+    auto child = run_command(false, false, "cmd.exe /c start \"\" \"" + path + "\"", working_dir, env, nullptr, ec, nullptr);
+    if (ec) {
+      BOOST_LOG(warning) << "[obs] could not start "sv << name << ": "sv << ec.message();
+      return false;
+    }
+    child.detach();
+    BOOST_LOG(info) << "[obs] started "sv << name;
+    return true;
+  }
+
+  /** @brief Window list in the format of the VR client: coordinates 0..1 of the video, y from the top, front-most first. */
+  std::string vr_windows_json() {
+    nlohmann::json out;
+    auto *h = shm_open_or_create();
+    const double cw = h && h->width ? (double) h->width : 1920.0;
+    const double ch = h && h->height ? (double) h->height : 1080.0;
+    out["screen"] = {{"w", (int) cw}, {"h", (int) ch}};
+    out["windows"] = nlohmann::json::array();
+    if (!h || !h->writer_alive) {
+      return out.dump();
+    }
+    struct row {
+      int z;
+      nlohmann::json j;
+    };
+    std::vector<row> rows;
+    const uint32_t n = std::min<uint32_t>(h->window_count, MOONLIGHT_MAX_WINDOWS);
+    for (uint32_t i = 0; i < n; ++i) {
+      const auto &w = h->windows[i];
+      if (!w.visible || w.w <= 0 || w.h <= 0) continue;
+      nlohmann::json j = {
+        {"x", w.x / cw},
+        {"y", w.y / ch},
+        {"w", w.w / cw},
+        {"h", w.h / ch},
+        {"z", w.z},
+        {"title", std::string(w.name, strnlen(w.name, sizeof(w.name)))},
+      };
+      j["id"] = w.hwnd ? (int64_t) w.hwnd : (int64_t) (i + 1);
+      rows.push_back({w.z, std::move(j)});
+    }
+    std::sort(rows.begin(), rows.end(), [](const row &a, const row &b) {
+      return a.z > b.z;
+    });
+    for (auto &r : rows) out["windows"].push_back(std::move(r.j));
+    return out.dump();
+  }
+}  // namespace platf
diff -ruN apollo/Apollo-master/src/platform/windows/moonlight_shm.h apollo_new/src/platform/windows/moonlight_shm.h
--- apollo/Apollo-master/src/platform/windows/moonlight_shm.h	1970-01-01 00:00:00.000000000 +0000
+++ apollo_new/src/platform/windows/moonlight_shm.h	2026-11-13 01:36:01.464809262 +0000
@@ -0,0 +1,44 @@
+// Shared between the OBS plugin (writer) and Apollo (creator/reader).
+// Apollo creates the mapping (it runs as a service with the privilege to
+// create Global\ objects); the OBS plugin opens it and writes frames.
+#pragma once
+#include <stdint.h>
+
+#define MOONLIGHT_SHM_NAME     L"Global\\ObsMoonlightShm"
+#define MOONLIGHT_SHM_MAGIC    0x4D4F4F4Eu  // 'MOON'
+#define MOONLIGHT_SHM_VERSION  2
+#define MOONLIGHT_MAX_WINDOWS  10
+#define MOONLIGHT_MAX_W        3840
+#define MOONLIGHT_MAX_H        2160
+#define MOONLIGHT_FRAME_BYTES  ((size_t) MOONLIGHT_MAX_W * MOONLIGHT_MAX_H * 4)
+
+#pragma pack(push, 8)
+struct MoonlightWindow {
+  int32_t  x, y, w, h;      // position/size inside the streamed canvas, pixels
+  int32_t  z;               // stacking order (0 = bottom)
+  int32_t  visible;
+  int64_t  hwnd;            // real PC window handle (0 if unknown)
+  char     name[96];        // OBS source name (UTF-8)
+  char     window[160];     // window_capture "window" setting: title:class:exe
+};
+
+struct MoonlightShm {
+  uint32_t magic;
+  uint32_t version;
+  volatile uint32_t writer_alive;  // plugin sets 1 while streaming, 0 on stop
+  uint32_t width, height;          // canvas size, BGRA, tightly packed
+  volatile uint32_t front;         // 0 or 1: buffer holding the latest frame
+  volatile uint64_t frame_seq;     // incremented after every completed frame
+  volatile uint64_t layout_seq;    // incremented when windows[] changes
+  uint32_t window_count;           // 0..MOONLIGHT_MAX_WINDOWS
+  MoonlightWindow windows[MOONLIGHT_MAX_WINDOWS];
+  // Apollo -> plugin: "an app was just launched, adopt its new window(s)"
+  volatile uint64_t launch_seq;
+  char     launch_name[128];
+};
+#pragma pack(pop)
+static_assert(sizeof(MoonlightShm) < 4096, "MoonlightShm must fit in the header page");
+
+// Mapping layout: [MoonlightShm header, padded to 4096][frame 0][frame 1]
+#define MOONLIGHT_HDR_BYTES   4096
+#define MOONLIGHT_SHM_BYTES   (MOONLIGHT_HDR_BYTES + 2 * MOONLIGHT_FRAME_BYTES)
